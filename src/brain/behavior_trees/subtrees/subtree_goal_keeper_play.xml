<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="GoalKeeperPlay">
      <ReactiveSequence >
         <SelfLocate mode="trust_direction" msecs_interval="3000" />
         <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="wait for opponent kickoff">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="!wait_for_opponent_kickoff" name="our kickoff or opponent already kicked off">
            <Sequence _while="ball_out">
               <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
               <GoBackInField />
               <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
            </Sequence>
            <ReactiveSequence _while="!ball_out">
               <ReactiveSequence _while="wait_for_opponent_kickoff" name="wait for opponent kickoff">
                  <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                  <SetVelocity />
               </ReactiveSequence>
               <Sequence _while="!wait_for_opponent_kickoff" name="normal play">
                  <Sequence>
                     <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                     <GoalieDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="3.0" close_threshold="2.6"/>
                     <!-- vx/vy 必须显式传入：节点默认值各 0.1 m/s（合模 0.14），只比本体行走死区
                          （合速度 <0.1 不响应、min_lin_speed=0.12）高一档，门将等于钉在站位点上；
                          球 3 m/s 横向穿过门前只需 1 s，需要 0.6~1.0 m/s 的横移才能封住两柱。
                          vy 会被本节点透传给 setVelocity 作为 vy 上限覆盖（硬上限 0.8），
                          只对门将生效，不动全局 robot.vy_limit（前锋/Assist 仍 0.4）。
                          50 号机实测：0.4 指令下 1 s 实际只走 0.22 m，覆盖率普遍不足 40%。 -->
                     <GoToGoalBlockingPosition _while="decision=='find'" dist_tolerance="0.25" theta_tolerance="0.3" dist_to_goalline="1.5" vx_limit="1.2" vy_limit="0.8" />
                     <GoToGoalBlockingPosition _while="decision == 'retreat'" dist_tolerance="0.25" theta_tolerance="0.3" dist_to_goalline="1.5" vx_limit="1.2" vy_limit="0.8" />
                     <GoToGoalBlockingPosition _while="decision == 'hold'" dist_tolerance="0.25" theta_tolerance="0.3" dist_to_goalline="1.5" vx_limit="1.2" vy_limit="0.8" />
                     <Adjust _while="decision =='adjust'" turn_threshold="0.8" range="0.2" vx_limit="1.0" vy_limit="0.8" vtheta_limit="1.6" vtheta_factor="4.5" tangential_speed_far="1.2" tangential_speed_near="0.3" />
                     <Kick _while="decision == 'kick'" speed_limit="2.4" min_msec_kick="600"/>
                  </Sequence>
               </Sequence>
            </ReactiveSequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
